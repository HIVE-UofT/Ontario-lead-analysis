                                        </td>
                                        <td style={{
                                            paddingLeft: 6,
                                            width: '20%',
                                            verticalAlign: 'bottom'
                                        }}>
                                            {x.c2}
                                        </td>
                                        <td style={{
                                            paddingLeft: 6,
                                            width: '38%',
                                            verticalAlign: 'bottom'
                                        }}>
                                            {x.c3}
                                        </td>
                                        <td style={{
                                            paddingLeft: 6,
                                            verticalAlign: 'bottom'
                                        }}>
                                            {x.c4}
                                        </td>
                                    </tr>
                                ))
