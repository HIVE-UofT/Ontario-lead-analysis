                        <div style={{ marginTop: '8px' }} />
                        <Text level={4} style={{ color: '#a8b7cc', fontSize: '1rem', lineHeight: '1' }}>
                            PLEASE DO NOT INCLUDE PERIODS OR ACCENTS IN SEARCH
                        </Text>
                    </Text>
                </center>

                {/* <VerticalText
                    a="Search our database for lead levels in water at Ontario schools and daycares"
                    b="Test results from 2019/20 to the 2022/23 school year"
                    c="PLEASE DO NOT INCLUDE PERIODS OR ACCENTS IN SEARCH"
                /> */}
                <AutoComplete size={SIZE}
