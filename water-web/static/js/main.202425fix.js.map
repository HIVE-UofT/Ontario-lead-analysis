                                destroyInactivePanel={true}
                            >
                                <Panel header={<Text style={{ color: 'RGB(39,78,130)' }}>YEARLY FAILURE DISTRIBUTION</Text>} key="1">
                                    <BasicChart type="scatter"
                                        data={[...Object.keys(selectedData?.section2 || {}).map((x) => {
                                            return selectedData?.section2[x]['failure rate'];
                                        })]}
                                        height={270}
                                        setAxis={false}
                                        showLabel={false}
                                        itemStyle={{
                                            color: 'black'
                                        }}
                                        opts={{
                                            tooltip: {
                                                show: true,
                                                formatter: '{b} - {c}%',
                                                trigger: 'axis',
                                            },
                                            xAxis: {
                                                type: 'category',
                                                data: [
                                                    ...Object.keys(selectedData?.section2 || {}).map((x) => {
                                                        return x.substring(0, 4) + '/' + x.substring(4);
                                                    })
                                                ],
                                                show: true,
                                                axisLabel: {
                                                    rotate: 45 // Rotate the labels by 45 degrees
                                                },
                                                name: 'Year'
                                            },
                                            yAxis: {
                                                type: 'value',
                                                show: true,
                                                axisLine: {
                                                    show: true, // Show the y-axis line
                                                    lineStyle: {
                                                        color: '#6C757D',//'#333', // Adjust line color as needed
                                                        width: 1 // Adjust line width as needed
                                                    }
                                                },
                                                splitLine: {
                                                    show: false // Hide the grid lines on the y-axis
                                                },
                                                name: 'Percent'
                                            },
                                            encode: { x: 'indicator', y: 'value' },
                                        }}
                                        additionalSeries={[
                                            {
                                                data: rateFailure,
                                                type: 'line',
                                                // barCategoryGap: '40%',
                                                itemStyle: {
                                                    color: 'RGB(213,106,88)'
                                                },
                                            }
                                        ]}
                                    />

                                </Panel>
                            </Collapse>
                        )}

                        <Collapse ghost style={{ padding: 0 }}
                            expandIcon={({ isActive }) => <CaretRightOutlined
                                style={{ color: 'RGB(213,106,88)' }} rotate={isActive ? 90 : 0} />}
                        >
                            <Panel header={<Text style={{ color: 'RGB(39,78,130)' }}>ALL RESULTS</Text>} key="1">
                                {/* <Table size='small' columns={columns}
                                    dataSource={
                                        Object.keys(selectedData?.section3 || {}).map((x, i) => {
                                            const item = selectedData?.section3[x];
                                            const date = new Date(item['Sample Date']);
                                            const year = date.getFullYear();
                                            const month = date.getMonth();
                                            const day = date.getDate();
                                            return {
                                                key: i + 10,
                                                c1: `${months[month]} ${day}, ${year}`,
                                                c2: item['Result'],
                                                c3: item['Sample Type Name'],
                                            }
                                        })
                                    }>
                                </Table> */}

                                <table style={{ borderCollapse: 'collapse' }}>
                                    {
                                        [
                                            {
                                                key: '1',
                                                c1: 'DATE',
                                                c2: 'RESULT\n(PPB)',
                                                c3: 'TEST TYPE',
                                            },
                                            ...Object.keys(selectedData?.section3 || {}).map((x, i) => {
                                                const item = selectedData?.section3[x];
                                                const date = new Date(item['Sample Date']);
                                                const year = date.getFullYear();
                                                const month = date.getMonth();
                                                const day = date.getDate();
                                                return {
                                                    key: i + 10,
                                                    c1: `${months[month]} ${day}, ${year}`,
                                                    c2: item['Result'],
                                                    c3: item['Sample Type Name'],
                                                }
                                            })
                                        ].map((x, i) => (
                                            <tr style={{ borderBottom: "1px solid #dddddd", color: i ? 'RGB(156,156,156)' : 'RGB(39,78,130)' }}>
                                                <td style={{
                                                    paddingLeft: 6,
                                                    width: '23%',
                                                    verticalAlign: i ? 'top' : 'bottom'
                                                }}>
                                                    {x.c1}
                                                </td>
                                                <td style={{
                                                    paddingLeft: 6,
                                                    width: '15%',
                                                    verticalAlign: i ? 'top' : 'bottom'
                                                }}>
                                                    {x.c2}
                                                </td>
                                                <td style={{
                                                    paddingLeft: 6,
                                                    width: '60%',
                                                    verticalAlign: i ? 'top' : 'bottom'
                                                }}>
                                                    {x.c3}
                                                </td>
                                            </tr>
                                        ))
                                    }
                                </table>

                            </Panel>
                        </Collapse>

                        {/* <details open={isOpen}>
                            <summary style={{ textAlign: 'center', cursor: 'pointer' }} onClick={() => setIsOpen(!isOpen)}>
                                {isOpen ? 'HIDE ' : 'SHOW '}
                                THE EXCEEDANCES
                            </summary>


                        </details> */}

                    </>
                )}
            </Card>
            <Space>
                <HiveLogo style={{ textAlign: 'center', marginTop: 6 }} />
                <Text style={{ fontSize: 10, color: 'RGB(156,156,156)', textAlign: 'center', marginTop: -6 }}>Developed by <a href="https://www.hivelab-uoft.ca/" target="_blank">HIVE LAB</a></Text>
            </Space>

        </Flex >
    );
