                            </p>
                        </p>

                    </div>

                    <BagBack />
                </Flex>
                <center style={{ paddingTop: 12 }}>

                    <Text level={4} style={{ textAlign: 'center', color: 'RGB(156,156,156)', fontSize: '1.2rem', lineHeight: '1' }}>
