                                }}>
                                    {selectedData?.section1['exceedance'] || 0}
                                </td>
                                <td style={{
                                    paddingLeft: 6,
                                    color: selectedData?.section1['failure rate'] ? 'RGB(213,106,88)' : 'RGB(39,78,130)'
                                }}>
                                    {selectedData?.section1['failure rate'] || 0}%
                                </td>
                            </tr>
                        </table>
                        <Divider style={{ marginTop: 12, marginBottom: 16 }} />
                        {selectedData?.section1['exceedance'] > 0 && (
