                                        setAxis={false}
                                        itemStyle={{
                                            color: function (params) {
                                                var colors = ['RGB(213,106,88)', 'RGB(39,78,130)'];//['#66768B', '#80BFDB', '#F39376']; // Example colors
                                                return colors[params.dataIndex % colors.length];
                                            }
                                        }}
                                        opts={{
                                            // title: {
                                            //     text: 'Referer of a Website',
                                            //     // subtext: 'Fake Data',
                                            //     left: 'center'
                                            // },
                                            legend: {
                                                orient: 'vertical',
                                                left: 'left'
                                            },
                                        }}
                                        series0={{
                                            radius: ['40%', '70%'],
                                            // emphasis: {
                                            //     label: {
                                            //         show: true,
                                            //         fontSize: 30,
                                            //         fontWeight: 'bold'
                                            //     }
                                            // },
                                        }}
                                        data={[
                                            { value: (selectedData?.section1['Y'] / (selectedData?.section1['Y'] + selectedData?.section1['N']) * 100).toFixed(2), name: 'Yes' },
                                            { value: (selectedData?.section1['N'] / (selectedData?.section1['Y'] + selectedData?.section1['N']) * 100).toFixed(2), name: 'No' }
                                        ]} />

                                    <Divider style={{ marginTop: 12, marginBottom: 16 }} />
                                </Panel>
                            </Collapse>
                        )}


